# API base URL. Include the backend BASE_URL path.
VITE_API_URL=https://rent-nest-auth.onrender.com/api/v1

# Optional local backend proxy target (used when VITE_API_URL is set to "/api/v1").
VITE_PROXY_TARGET=http://localhost:5000

# Dev server port. Must match the backend CLIENT_URL (default http://localhost:3000)
# because password-reset emails link to CLIENT_URL/reset-password/:token.
VITE_DEV_PORT=3000
