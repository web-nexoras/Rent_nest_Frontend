# API base path. Keep "/api/v1" in development (requests are proxied by Vite).
# BASE_URL in the backend .env must match this path.
VITE_API_URL=/api/v1

# Where the Vite dev/preview server proxies "/api" to (the Rent Nest backend).
VITE_PROXY_TARGET=http://localhost:5000

# Dev server port. Must match the backend CLIENT_URL (default http://localhost:3000)
# because password-reset emails link to CLIENT_URL/reset-password/:token.
VITE_DEV_PORT=3000
